# Copy this file to .env and fill in your key. .env is gitignored — never commit secrets.
#   cp .env.example .env

# Required: your Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional model overrides (defaults shown).
# GEMINI_SCOUT_MODEL=gemini-3.5-flash
# GEMINI_ANALYST_MODEL=gemini-3.5-flash

# Optional validation-gate tuning.
# COPA_GATE_THRESHOLD=75
# COPA_MIN_PLAYERS=1
# COPA_MAX_PLAYERS=30

# Optional: a CC-licensed match image for the smoke-test / demo.
# IMAGE_URL=https://commons.wikimedia.org/wiki/Special:FilePath/Example_match.jpg
